
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СоздатьРеквизитОсновнойДоговор();
	СоздатьКомандыФормы();
	СоздатьЭлементыФормы();
	ОбновитьСвойстваЭлементовФормы();
	ЗаполнитьОсновнойДоговор();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКонтрагентаПриИзменении(Элемент)
	
	ОбновитьСвойстваЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУНП(Команда)
	
	Если ПустаяСтрока(Объект.ИНН) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Операция невозможна: не заполнен ИНН!";
		Сообщение.Поле = "Объект.ИНН";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	
	Сведения = ПолучитьСведенияПоУНП(СокрЛП(Объект.ИНН));
	Если Сведения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Сведения.НаименованиеПолное <> Объект.НаименованиеПолное
		ИЛИ Сведения.Наименование <> Объект.Наименование Тогда
		
		ТекстВопроса = "Для УНП " + Объект.ИНН + " в государственном реестре плательщиков соответствует юридическое лицо со следующими реквизитами
		|
		| Наименование: " + Сведения.Наименование + "
		| Полное наименование: " + Сведения.НаименованиеПолное + "
		| Юридический адрес: " + Сведения.ЮрАдрес + "
		|
		|Установить данные реквизиты для текущего контрагента?";
		
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоУНПЗавершение", ЭтотОбъект, Сведения);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоУНПЗавершение(РезультатВопроса, Сведения) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Наименование = Сведения.Наименование;
	Объект.НаименованиеПолное = Сведения.НаименованиеПолное;
	ЗаписатьЮридическийАдрес(Сведения.ЮрАдрес);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеНовая(Команда)
	
	ПроверитьЗаполнениеНоваяНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитОсновнойДоговор()
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"ОсновнойДоговор",
		Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"),
		,
		"Основной договор"));
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКомандыФормы()
	
	КомандаЗаполнить = Команды.Добавить("ЗаполнитьПоУНП");
	КомандаЗаполнить.Заголовок = "Заполнить по УНП";
	КомандаЗаполнить.Подсказка = "Заполнить по УНП";
	КомандаЗаполнить.Действие = "ЗаполнитьПоУНП";
	КомандаЗаполнить.Картинка = БиблиотекаКартинок.ВводНаОсновании;
	КомандаЗаполнить.Отображение = ОтображениеКнопки.Картинка;
	КомандаЗаполнить.ИзменяетСохраняемыеДанные = Истина;
	
	КомандаПроверить = Команды.Добавить("ПроверитьЗаполнениеНовая");
	КомандаПроверить.Заголовок = "Проверить заполнение новая";
	КомандаПроверить.Подсказка = "Проверить заполнение новая";
	КомандаПроверить.Действие = "ПроверитьЗаполнениеНовая";
	КомандаПроверить.Картинка = БиблиотекаКартинок.ОформлениеФлажок;
	КомандаПроверить.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы()
	
	ПолеНаименование = Элементы.Добавить("Наименование", Тип("ПолеФормы"));
	ПолеНаименование.ПутьКДанным = "Объект.Наименование";
	ПолеНаименование.Вид = ВидПоляФормы.ПолеВвода;
	ПолеНаименование.ЦветФона = ЦветаСтиля.ЦветНавигации;
	ПолеНаименование.Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста, , , Истина);
	
	ПолеНаименованиеПолное = Элементы.Добавить("НаименованиеПолное", Тип("ПолеФормы"));
	ПолеНаименованиеПолное.ПутьКДанным = "Объект.НаименованиеПолное";
	ПолеНаименованиеПолное.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеВидКонтрагента = Элементы.Добавить("ВидКонтрагента", Тип("ПолеФормы"));
	ПолеВидКонтрагента.ПутьКДанным = "Объект.ВидКонтрагента";
	ПолеВидКонтрагента.Вид = ВидПоляФормы.ПолеПереключателя;
	ПолеВидКонтрагента.ВидПереключателя = ВидПереключателя.Тумблер;
	ПолеВидКонтрагента.СписокВыбора.Добавить(Перечисления.ВидыКонтрагентов.ЮридическоеЛицо);
	ПолеВидКонтрагента.СписокВыбора.Добавить(Перечисления.ВидыКонтрагентов.ИндивидуальныйПредприниматель);
	ПолеВидКонтрагента.СписокВыбора.Добавить(Перечисления.ВидыКонтрагентов.ФизическоеЛицо);
	ПолеВидКонтрагента.УстановитьДействие("ПриИзменении", "ВидКонтрагентаПриИзменении");
	
	ГруппаИННКатегория = Элементы.Добавить("ГруппаИННКатегория", Тип("ГруппаФормы"));
	ГруппаИННКатегория.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаИННКатегория.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаИННКатегория.ОтображатьЗаголовок = Ложь;
	
	ПолеИНН = Элементы.Добавить("ИНН", Тип("ПолеФормы"), ГруппаИННКатегория);
	ПолеИНН.ПутьКДанным = "Объект.ИНН";
	ПолеИНН.Вид = ВидПоляФормы.ПолеВвода;
	ПолеИНН.ПодсказкаВвода = "Введите ИНН";
	ПолеИНН.ЦветФона = ЦветаСтиля.ЦветНавигации;
	ПолеИНН.РастягиватьПоГоризонтали = Ложь;
	ПолеИНН.Ширина = 14;
	
	КнопкаЗаполнитьПоУНП = Элементы.Добавить("ЗаполнитьПоУНП", Тип("КнопкаФормы"), ГруппаИННКатегория);
	КнопкаЗаполнитьПоУНП.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаЗаполнитьПоУНП.ИмяКоманды = "ЗаполнитьПоУНП";
	КнопкаЗаполнитьПоУНП.Отображение = ОтображениеКнопки.Картинка;
	КнопкаЗаполнитьПоУНП.РастягиватьПоГоризонтали = Ложь;
	
	ПолеКатегория = Элементы.Добавить("Категория", Тип("ПолеФормы"), ГруппаИННКатегория);
	ПолеКатегория.ПутьКДанным = "Объект.Категория";
	ПолеКатегория.Вид = ВидПоляФормы.ПолеПереключателя;
	ПолеКатегория.ВидПереключателя = ВидПереключателя.Тумблер;
	ПолеКатегория.СписокВыбора.Добавить(Перечисления.КатегорииКонтрагентов.Важный);
	ПолеКатегория.СписокВыбора.Добавить(Перечисления.КатегорииКонтрагентов.Обычный);
	ПолеКатегория.СписокВыбора.Добавить(Перечисления.КатегорииКонтрагентов.Ключевой);
	
	ГруппаСтранаКПП = Элементы.Добавить("ГруппаСтранаКПП", Тип("ГруппаФормы"));
	ГруппаСтранаКПП.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСтранаКПП.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаСтранаКПП.ОтображатьЗаголовок = Ложь;
	
	ПолеСтрана = Элементы.Добавить("СтранаРегистрации", Тип("ПолеФормы"), ГруппаСтранаКПП);
	ПолеСтрана.ПутьКДанным = "Объект.СтранаРегистрации";
	ПолеСтрана.Вид = ВидПоляФормы.ПолеВвода;
	
	ПолеКПП = Элементы.Добавить("КПП", Тип("ПолеФормы"), ГруппаСтранаКПП);
	ПолеКПП.ПутьКДанным = "Объект.КПП";
	ПолеКПП.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКПП.РастягиватьПоГоризонтали = Ложь;
	ПолеКПП.Ширина = 14;
	
	ПолеОсновнойДоговор = Элементы.Добавить("ОсновнойДоговор", Тип("ПолеФормы"));
	ПолеОсновнойДоговор.ПутьКДанным = "ОсновнойДоговор";
	ПолеОсновнойДоговор.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеОсновнойДоговор.Гиперссылка = Истина;
	
	ГруппаФлажки = Элементы.Добавить("ГруппаФлажки", Тип("ГруппаФормы"));
	ГруппаФлажки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаФлажки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяЕслиВозможно;
	ГруппаФлажки.ОтображатьЗаголовок = Ложь;
	
	ДобавитьФлажок("Покупатель", "Объект.Покупатель", ГруппаФлажки);
	ДобавитьФлажок("Поставщик", "Объект.Поставщик", ГруппаФлажки);
	ДобавитьФлажок("ПрочиеОтношения", "Объект.ПрочиеОтношения", ГруппаФлажки);
	
	Страницы = Элементы.Добавить("Страницы", Тип("ГруппаФормы"));
	Страницы.Вид = ВидГруппыФормы.Страницы;
	Страницы.РастягиватьПоВертикали = Истина;
	
	СтраницаКонтактнаяИнформация = Элементы.Добавить(
		"СтраницаКонтактнаяИнформация", Тип("ГруппаФормы"), Страницы);
	СтраницаКонтактнаяИнформация.Вид = ВидГруппыФормы.Страница;
	СтраницаКонтактнаяИнформация.Заголовок = "Контактная информация";
	СоздатьТаблицуКонтактнойИнформации(СтраницаКонтактнаяИнформация);
	
	СтраницаДополнительныеРеквизиты = Элементы.Добавить(
		"СтраницаДополнительныеРеквизиты", Тип("ГруппаФормы"), Страницы);
	СтраницаДополнительныеРеквизиты.Вид = ВидГруппыФормы.Страница;
	СтраницаДополнительныеРеквизиты.Заголовок = "Дополнительные реквизиты";
	СоздатьТаблицуДополнительныхРеквизитов(СтраницаДополнительныеРеквизиты);
	
	ПолеИсточник = Элементы.Добавить("ИсточникПривлечения", Тип("ПолеФормы"));
	ПолеИсточник.ПутьКДанным = "Объект.ИсточникПривлечения";
	ПолеИсточник.Вид = ВидПоляФормы.ПолеВвода;
	
	КнопкаПроверить = Элементы.Добавить(
		"ФормаПроверитьЗаполнение", Тип("КнопкаФормы"), Элементы.ФормаКоманднаяПанель);
	КнопкаПроверить.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	КнопкаПроверить.ИмяКоманды = "ПроверитьЗаполнениеНовая";
	КнопкаПроверить.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьФлажок(Имя, ПутьКДанным, Родитель)
	
	Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.ПутьКДанным = ПутьКДанным;
	Поле.Вид = ВидПоляФормы.ПолеФлажка;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьТаблицуКонтактнойИнформации(Родитель)
	
	Таблица = Элементы.Добавить("КонтактнаяИнформация", Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = "Объект.КонтактнаяИнформация";
	Таблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Таблица.ИзменятьСоставСтрок = Истина;
	Таблица.ИзменятьПорядокСтрок = Истина;
	Таблица.РастягиватьПоВертикали = Истина;
	
	ДобавитьКолонкуТаблицы(Таблица, "КонтактнаяИнформацияНомерСтроки",
		"Объект.КонтактнаяИнформация.НомерСтроки", ВидПоляФормы.ПолеНадписи);
	ДобавитьКолонкуТаблицы(Таблица, "КонтактнаяИнформацияТип",
		"Объект.КонтактнаяИнформация.Тип", ВидПоляФормы.ПолеВвода);
	ДобавитьКолонкуТаблицы(Таблица, "КонтактнаяИнформацияВид",
		"Объект.КонтактнаяИнформация.Вид", ВидПоляФормы.ПолеВвода);
	ДобавитьКолонкуТаблицы(Таблица, "КонтактнаяИнформацияЗначение",
		"Объект.КонтактнаяИнформация.Значение", ВидПоляФормы.ПолеВвода);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьТаблицуДополнительныхРеквизитов(Родитель)
	
	Таблица = Элементы.Добавить("ДополнительныеРеквизиты", Тип("ТаблицаФормы"), Родитель);
	Таблица.ПутьКДанным = "Объект.ДополнительныеРеквизиты";
	Таблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	Таблица.ИзменятьСоставСтрок = Истина;
	Таблица.ИзменятьПорядокСтрок = Истина;
	Таблица.РастягиватьПоВертикали = Истина;
	
	ДобавитьКолонкуТаблицы(Таблица, "ДополнительныеРеквизитыНомерСтроки",
		"Объект.ДополнительныеРеквизиты.НомерСтроки", ВидПоляФормы.ПолеНадписи);
	ДобавитьКолонкуТаблицы(Таблица, "ДополнительныеРеквизитыДопРеквизит",
		"Объект.ДополнительныеРеквизиты.ДопРеквизит", ВидПоляФормы.ПолеВвода);
	ДобавитьКолонкуТаблицы(Таблица, "ДополнительныеРеквизитыЗначение",
		"Объект.ДополнительныеРеквизиты.Значение", ВидПоляФормы.ПолеВвода);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуТаблицы(Таблица, Имя, ПутьКДанным, ВидПоля)
	
	Колонка = Элементы.Добавить(Имя, Тип("ПолеФормы"), Таблица);
	Колонка.ПутьКДанным = ПутьКДанным;
	Колонка.Вид = ВидПоля;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСвойстваЭлементовФормы()
	
	Если Объект.ВидКонтрагента = Перечисления.ВидыКонтрагентов.ФизическоеЛицо Тогда
		Элементы.Наименование.Заголовок = "ФИО";
		Элементы.ИНН.Видимость = Ложь;
	Иначе
		Элементы.Наименование.Заголовок = "Наименование";
		Элементы.ИНН.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОсновнойДоговор()
	
	Если Объект.Ссылка.Пустая() Тогда
		Элементы.ОсновнойДоговор.Видимость = Ложь;
	Иначе
		ОсновнойДоговор = ПолучитьОсновнойДоговорКонтрагента(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЮридическийАдрес(ЮрАдресПортал)
	
	ВидКИ_ЮрАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагента;
	СтрокиАдреса = Объект.КонтактнаяИнформация.НайтиСтроки(Новый Структура("Вид", ВидКИ_ЮрАдрес));
	Если СтрокиАдреса.Количество() = 0 Тогда
		СтрокаКИ = Объект.КонтактнаяИнформация.Добавить();
		СтрокаКИ.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
		СтрокаКИ.Вид = ВидКИ_ЮрАдрес;
		СтрокаКИ.Значение = ЮрАдресПортал;
	Иначе
		СтрокиАдреса[0].Значение = ЮрАдресПортал;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнениеНоваяНаСервере()
	
	КонтрагентОбъект = РеквизитФормыВЗначение("Объект");
	РезультатПроверки = КонтрагентОбъект.ПроверитьЗаполнение();
	Если РезультатПроверки = Истина Тогда
		Сообщить("Ошибок не обнаружено!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСведенияПоУНП(ИНН)
	
	Хост = "www.portal.nalog.gov.by";
	Ресурс = "grp/getData?unp=" + ИНН;
	
	Соединение = Новый HTTPСоединение(Хост);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("host", Хост);
	Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
	
	Попытка
		Ответ = Соединение.Получить(Запрос);
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		СведенияXML = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(СведенияXML) <> Тип("ОбъектXDTO")
		Или СведенияXML.Свойства().Получить("ROW") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЮрАдрес = СокрЛП(СведенияXML.ROW.VPADRES);
	Если Лев(ЮрАдрес, 2) = ", " Тогда
		ЮрАдрес = Прав(ЮрАдрес, СтрДлина(ЮрАдрес) - 2);
	КонецЕсли;
	
	Сведения = Новый Структура;
	Сведения.Вставить("Наименование", СокрЛП(СведенияXML.ROW.VNAIMK));
	Сведения.Вставить("НаименованиеПолное", СокрЛП(СведенияXML.ROW.VNAIMP));
	Сведения.Вставить("ЮрАдрес", ЮрАдрес);
	
	Возврат Сведения;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОсновнойДоговорКонтрагента(Контрагент)
	
	Возврат Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту("Основной", Истина, , Контрагент);
	
КонецФункции
